# Frontend Dashboard Overhaul Implementation Guide

## Overview

The backend has been completely restructured to support **two separate dashboards**: Factory and Store. This document provides comprehensive guidance for frontend implementation.

## 🏗️ Architecture Changes

### Dashboard Separation
- **Factory Dashboard**: Manufacturing, production, raw materials, components
- **Store Dashboard**: Simple retail, inventory management only
- **Complete Data Isolation**: Each dashboard has its own data, customers, analytics

### API Structure
```
/api/factory/*  - Factory dashboard endpoints
/api/store/*    - Store dashboard endpoints
/api/core/*     - Legacy endpoints (default to factory)
```

---

## 📋 Frontend Implementation Requirements

### 1. Dashboard Selection System

#### Dashboard Context Provider
```typescript
// DashboardContext.tsx
interface DashboardContextType {
  currentDashboard: 'factory' | 'store';
  setDashboard: (dashboard: 'factory' | 'store') => void;
  isFactory: boolean;
  isStore: boolean;
}

const DashboardContext = createContext<DashboardContextType | null>(null);

export const DashboardProvider = ({ children }: { children: ReactNode }) => {
  const [currentDashboard, setCurrentDashboard] = useState<'factory' | 'store'>('factory');
  
  const setDashboard = (dashboard: 'factory' | 'store') => {
    setCurrentDashboard(dashboard);
    localStorage.setItem('selectedDashboard', dashboard);
  };

  return (
    <DashboardContext.Provider value={{
      currentDashboard,
      setDashboard,
      isFactory: currentDashboard === 'factory',
      isStore: currentDashboard === 'store'
    }}>
      {children}
    </DashboardContext.Provider>
  );
};
```

#### Dashboard Selector Component
```typescript
// DashboardSelector.tsx
const DashboardSelector = () => {
  const { currentDashboard, setDashboard } = useDashboard();
  
  return (
    <div className="dashboard-selector">
      <button 
        className={currentDashboard === 'factory' ? 'active' : ''}
        onClick={() => setDashboard('factory')}
      >
        🏭 Factory Dashboard
      </button>
      <button 
        className={currentDashboard === 'store' ? 'active' : ''}
        onClick={() => setDashboard('store')}
      >
        🏪 Store Dashboard
      </button>
    </div>
  );
};
```

### 2. API Service Layer

#### Base API Configuration
```typescript
// api/config.ts
const getBaseURL = (dashboard: 'factory' | 'store') => {
  return `/api/${dashboard}`;
};

export const apiFactory = {
  baseURL: getBaseURL('factory'),
  endpoints: {
    stock: '/stock',
    customers: '/customer',
    units: '/unit',
    categories: '/category',
    analytics: '/analytics',
    rawMaterials: '/raw-material',
    manufacturing: '/manufacturing'
  }
};

export const apiStore = {
  baseURL: getBaseURL('store'),
  endpoints: {
    stock: '/stock',
    customers: '/customer',
    units: '/unit',
    categories: '/category',
    analytics: '/analytics'
  }
};
```

#### Dynamic API Service
```typescript
// api/service.ts
export class ApiService {
  private dashboard: 'factory' | 'store';
  
  constructor(dashboard: 'factory' | 'store') {
    this.dashboard = dashboard;
  }
  
  private getBaseURL() {
    return this.dashboard === 'factory' ? apiFactory.baseURL : apiStore.baseURL;
  }
  
  // Stock Management
  async getStock() {
    return fetch(`${this.getBaseURL()}/stock`);
  }
  
  async addStock(data: any) {
    return fetch(`${this.getBaseURL()}/stock`, {
      method: 'POST',
      body: JSON.stringify(data)
    });
  }
  
  // Production (Factory only)
  async produceStock(id: number, data: any) {
    if (this.dashboard !== 'factory') {
      throw new Error('Production only available in Factory dashboard');
    }
    return fetch(`${this.getBaseURL()}/stock/${id}/produce`, {
      method: 'POST',
      body: JSON.stringify(data)
    });
  }
  
  // Raw Materials (Factory only)
  async getRawMaterials() {
    if (this.dashboard !== 'factory') {
      throw new Error('Raw materials only available in Factory dashboard');
    }
    return fetch(`${this.getBaseURL()}/raw-material`);
  }
}
```

