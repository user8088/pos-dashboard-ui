### Feature Detection
```typescript
const getAvailableFeatures = (dashboard: 'factory' | 'store') => {
  const baseFeatures = ['stock', 'customers', 'analytics', 'transport', 'payables'];
  
  if (dashboard === 'factory') {
    return [...baseFeatures, 'production', 'rawMaterials', 'manufacturing', 'components'];
  }
  
  return baseFeatures;
};
```

