### Minimal Fetch Helper

```javascript
export async function fetchUdhaars({ token, params = {} }) {
  const query = new URLSearchParams(params).toString();
  const res = await fetch(`/api/udhaars${query ? `?${query}` : ''}`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!res.ok) throw new Error(`Failed to load udhaars (${res.status})`);
  return res.json();
}
```

### React Example (with filters + pagination)

```javascript
import { useEffect, useMemo, useState } from 'react';
import { fetchUdhaars } from './api/udhaar';

export default function UdhaarList({ token }) {
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [page, setPage] = useState(1);
  const [perPage, setPerPage] = useState(15);
  const [status, setStatus] = useState(''); // '', 'active', 'fully_paid', 'cancelled'
  const [userId, setUserId] = useState('');

  const params = useMemo(() => {
    const p = { page, per_page: perPage };
    if (status) p.status = status;
    if (userId) p.user_id = userId;
    return p;
  }, [page, perPage, status, userId]);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError(null);
    fetchUdhaars({ token, params })
      .then((json) => {
        if (cancelled) return;
        setRows(json?.data ?? []);
        // optionally read json.pagination to render controls
      })
      .catch((e) => !cancelled && setError(e.message))
      .finally(() => !cancelled && setLoading(false));
    return () => {
      cancelled = true;
    };
  }, [token, params]);

  return (
    <div>
      <h2>Udhaar</h2>
      <div style={{ display: 'flex', gap: 8, marginBottom: 12 }}>
        <input
          placeholder="Filter by User ID"
          value={userId}
          onChange={(e) => setUserId(e.target.value)}
        />
        <select value={status} onChange={(e) => setStatus(e.target.value)}>
          <option value="">All</option>
          <option value="active">Active</option>
          <option value="fully_paid">Fully Paid</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>

      {loading && <div>Loading…</div>}
      {error && <div style={{ color: 'red' }}>{error}</div>}

      {!loading && !error && (
        <table width="100%" cellPadding={8} style={{ borderCollapse: 'collapse' }}>
          <thead>
            <tr>
              <th align="left">ID</th>
              <th align="left">Staff</th>
              <th align="right">Amount</th>
              <th align="right">Paid</th>
              <th align="right">Remaining</th>
              <th align="left">Status</th>
              <th align="left">Loan Date</th>
              <th align="left">Last Payment</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr key={r.id}>
                <td>{r.id}</td>
                <td>{r.staff?.name ?? r.user_id}</td>
                <td align="right">{r.amount}</td>
                <td align="right">{r.total_paid}</td>
                <td align="right">{r.remaining_amount}</td>
                <td>{r.status}</td>
                <td>{r.loan_date}</td>
                <td>{r.last_payment_date ?? '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <div style={{ marginTop: 12, display: 'flex', gap: 8 }}>
        <button disabled={page <= 1} onClick={() => setPage((p) => p - 1)}>
          Prev
        </button>
        <span>Page {page}</span>
        <button onClick={() => setPage((p) => p + 1)}>Next</button>
        <select value={perPage} onChange={(e) => setPerPage(Number(e.target.value))}>
          {[10, 15, 25, 50].map((n) => (
            <option key={n} value={n}>
              {n} / page
            </option>
          ))}
        </select>
      </div>
    </div>
  );
}
```

### Vue 3 Composition API (optional)

```javascript
<script setup>
import { ref, watch, onMounted } from 'vue';

const props = defineProps({ token: { type: String, required: true } });
const rows = ref([]);
const loading = ref(false);
const error = ref('');
const page = ref(1);
const perPage = ref(15);
const status = ref('');
const userId = ref('');

async function load() {
  loading.value = true;
  error.value = '';
  try {
    const qs = new URLSearchParams({
      page: String(page.value),
      per_page: String(perPage.value),
      ...(status.value ? { status: status.value } : {}),
      ...(userId.value ? { user_id: userId.value } : {}),
    }).toString();
    const res = await fetch(`/api/udhaars?${qs}`, {
      headers: { Authorization: `Bearer ${props.token}` },
    });
    if (!res.ok) throw new Error(String(res.status));
    const json = await res.json();
    rows.value = json?.data ?? [];
  } catch (e) {
    error.value = e.message || 'Failed to load';
  } finally {
    loading.value = false;
  }
}

watch([page, perPage, status, userId], load);
onMounted(load);
</script>

<template>
  <div>
    <h2>Udhaar</h2>
    <div style="display:flex; gap:8px; margin-bottom:12px;">
      <input placeholder="Filter by User ID" v-model="userId" />
      <select v-model="status">
        <option value="">All</option>
        <option value="active">Active</option>
        <option value="fully_paid">Fully Paid</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>

    <div v-if="loading">Loading…</div>
    <div v-else-if="error" style="color:red">{{ error }}</div>
    <table v-else width="100%" cellpadding="8" style="border-collapse:collapse">
      <thead>
        <tr>
          <th align="left">ID</th>
          <th align="left">Staff</th>
          <th align="right">Amount</th>
          <th align="right">Paid</th>
          <th align="right">Remaining</th>
          <th align="left">Status</th>
          <th align="left">Loan Date</th>
          <th align="left">Last Payment</th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="r in rows" :key="r.id">
          <td>{{ r.id }}</td>
          <td>{{ r.staff?.name ?? r.user_id }}</td>
          <td align="right">{{ r.amount }}</td>
          <td align="right">{{ r.total_paid }}</td>
          <td align="right">{{ r.remaining_amount }}</td>
          <td>{{ r.status }}</td>
          <td>{{ r.loan_date }}</td>
          <td>{{ r.last_payment_date ?? '-' }}</td>
        </tr>
      </tbody>
    </table>

    <div style="margin-top:12px; display:flex; gap:8px;">
      <button :disabled="page <= 1" @click="page -= 1">Prev</button>
      <span>Page {{ page }}</span>
      <button @click="page += 1">Next</button>
      <select v-model.number="perPage">
        <option v-for="n in [10,15,25,50]" :key="n" :value="n">{{ n }} / page</option>
      </select>
    </div>
  </div>
  
</template>
```

### Suggested Columns

- **ID**: `id`
- **Staff**: `staff.name` (fallback `user_id`)
- **Amount**: `amount`
- **Paid**: `total_paid`
- **Remaining**: `remaining_amount`
- **Status**: `status`
- **Loan Date**: `loan_date`
- **Last Payment**: `last_payment_date` (nullable)

### Tips

- **Server-side filters**: Prefer passing `status`, `user_id`, and date range to avoid overfetching.
- **Pagination**: Use backend `pagination` fields to render page controls when available.
- **Empty states**: Show a friendly message if `data` is empty.
- **Errors**: Display `response.message` when `success` is false.

For full API details, see `UDHAAR_LOAN_API.md`.


