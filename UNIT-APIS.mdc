## Frontend Integration Examples

### Vue.js / React Example

```javascript
// Add stock with secondary unit
async function addStockWithConversion(stockData) {
  const response = await fetch('/api/core/stock', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      item_name: stockData.name,
      unit_id: stockData.primaryUnitId,
      secondary_unit_id: stockData.secondaryUnitId,
      conversion_factor: stockData.conversionFactor,
      allow_secondary_sales: true,
      quantity_per_unit: stockData.quantity,
      item_price: stockData.price
    })
  });
  return response.json();
}

// Sell in secondary units
async function sellInSecondaryUnits(customerId, items) {
  const response = await fetch(`/api/core/customer/${customerId}/purchase`, {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      items: items.map(item => ({
        stock_id: item.stockId,
        quantity: item.quantity,
        use_secondary_unit: true, // Sell in secondary units
        unit_price: item.pricePerSecondaryUnit
      })),
      paid_cash: calculateTotal(items)
    })
  });
  return response.json();
}

// Display available quantity in both units
function displayAvailability(stock) {
  if (stock.allow_secondary_sales && stock.secondaryUnit) {
    return `
      Available: ${stock.quantity_per_unit} ${stock.unit.unit_name}
      (${stock.available_secondary_quantity} ${stock.secondaryUnit.unit_name})
    `;
  }
  return `Available: ${stock.quantity_per_unit} ${stock.unit.unit_name}`;
}
```

